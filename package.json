{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "build": "pnpm build.client && pnpm build.preview",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.netlify": "pnpm build.client && vite build --config adapters/netlify-edge/vite.config.ts",
    "build.types": "tsc --noEmit",
    "preview": "pnpm build && vite preview",
    "lint": "tsc --noEmit",
    "test": "node --test",
    "fmt": "prettier --write ."
  },
  "dependencies": {
    "@builder.io/qwik": "^1.20.1",
    "@builder.io/qwik-city": "^1.20.1",
    "@devicons-pack/sprite": "2.1.0",
    "qwik-speak": "^0.24.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.12.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vite-tsconfig-paths": "^5.0.1"
  }
}
