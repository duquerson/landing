# Telegram Bot API (https://core.telegram.org/bots/api)
# Obtén el token hablando con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here

# ID del chat donde recibir mensajes (tu ID personal o de grupo)
# Obtén el ID enviando un mensaje al bot y visitando https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your-chat-id-here
