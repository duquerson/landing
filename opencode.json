{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx", "-y", "chrome-devtools-mcp@latest",
          "--slim",
          "--headless",
          "--no-usage-statistics",
          "--no-performance-crux"
        ]
      }
    }
  }
}